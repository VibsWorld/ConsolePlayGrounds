<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Exam Registration</title>
    <style>
        :root { color-scheme: light; }
        body {
            font-family: "Segoe UI", system-ui, sans-serif;
            background: #f4f6fb;
            color: #1c2333;
            margin: 0;
            padding: 2rem 1rem;
        }
        .shell {
            max-width: 640px;
            margin: 0 auto;
            background: #fff;
            border: 1px solid #e2e6f0;
            border-radius: 12px;
            padding: 2rem;
            box-shadow: 0 6px 24px rgba(28, 35, 51, .06);
        }
        h1 { margin-top: 0; font-size: 1.5rem; }
        .steps { display: flex; gap: .5rem; margin-bottom: 1.5rem; font-size: .85rem; color: #7a839b; }
        .steps .active { color: #2f5bea; font-weight: 600; }
        label { display: block; margin: 1rem 0 .35rem; font-weight: 600; font-size: .9rem; }
        input[type="text"], input[type="email"] {
            width: 100%; padding: .6rem .7rem; border: 1px solid #cbd2e1;
            border-radius: 8px; font-size: 1rem; box-sizing: border-box;
        }
        .check { display: flex; align-items: center; gap: .55rem; margin: .6rem 0; font-weight: 500; }
        .check input { width: 1.05rem; height: 1.05rem; }
        .btn {
            margin-top: 1.5rem; padding: .65rem 1.4rem; border: 0; border-radius: 8px;
            background: #2f5bea; color: #fff; font-size: 1rem; cursor: pointer;
        }
        .btn:hover { background: #2449c9; }
        .summary {
            background: #f7f9ff; border: 1px solid #e2e6f0; border-radius: 8px;
            padding: .9rem 1.1rem; margin: 1rem 0; font-size: .92rem;
        }
        .summary div { display: flex; justify-content: space-between; padding: .2rem 0; }
        .fee { font-weight: 700; font-size: 1.1rem; }
        .success { color: #1a7f52; }
    </style>
</head>
<body>
    <div class="shell">
        @RenderBody()
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
